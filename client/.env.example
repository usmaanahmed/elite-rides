# Google Maps key (browser) - address suggestions ke liye. "Places API (New)" + "Maps JavaScript API" enable honi chahiye
VITE_GOOGLE_MAPS_API_KEY=
# Google "Map ID" (Google Cloud > Map Management) - tour page ke map ke pins ke liye. Khali chhoro to testing wala "DEMO_MAP_ID" use hota hai
VITE_GOOGLE_MAP_ID=
# Server ki API (booking, quote, vehicles)
VITE_API_URL=http://localhost:5000/api
