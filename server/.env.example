PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/elite-rides
CLIENT_URL=http://localhost:5173,http://localhost:5174
JWT_SECRET=replace-with-a-long-random-string

# Yeh teen sirf "npm run seed:admin" chalane ke waqt chahiye hoti hain (pehla admin banane ke liye)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@eliterides.com
ADMIN_PASSWORD=change-this-password

# Quote ke distance (miles) ke liye Google key (Routes API ya Directions API enable honi chahiye).
# Yeh server wali alag key honi chahiye, browser wali (HTTP referrer restricted) key server par kaam nahi karti.
GOOGLE_MAPS_API_KEY=

# Customer website ka address (Stripe payment ke baad customer yahan wapas aata hai)
WEBSITE_URL=http://localhost:5174

# Stripe card payment. Development me TEST keys (sk_test_...) use karo.
# Khaali ho to website par card payment ka option nahi dikhta.
STRIPE_SECRET_KEY=
# Webhook ka secret (whsec_...). Local testing: "stripe listen --forward-to localhost:5000/api/payments/stripe/webhook"
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=gbp
